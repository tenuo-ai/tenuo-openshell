FROM rust:1.91-bookworm AS signer
WORKDIR /source
COPY Cargo.toml Cargo.lock build.rs ./
COPY proto ./proto
COPY src ./src
RUN cargo build --release --locked --bin tenuo-demo-fixture

FROM nvcr.io/nvidia/base/ubuntu@sha256:c280ee89f8bfcbdaba6179ad4347f60c509e841cbe63eb93002f01bf70e0819c

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupmod --new-name sandbox ubuntu \
    && usermod --login sandbox --home /home/sandbox --move-home ubuntu

# The task runtime generates its holder key and signs each call inside the
# sandbox. The signer makes no network request; curl sends the signed body.
COPY --from=signer /source/target/release/tenuo-demo-fixture /usr/local/bin/tenuo-signer

USER sandbox
WORKDIR /home/sandbox
